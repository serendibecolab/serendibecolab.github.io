{
  "name": "serendib-eco-lab",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev --host",
    "preview": "astro preview",
    "astro": "astro",
    "start": "python3 -m http.server --directory dist 3000",
    "build:gh-pages": "bash -lc 'REPO=${GITHUB_PAGES_REPO:-${GITHUB_REPOSITORY:-}}; if [ -z \"$REPO\" ]; then echo \"Usage: GITHUB_PAGES_REPO=owner/repo pnpm run build:gh-pages\"; exit 1; fi; OWNER=${REPO%%/*}; REPO_NAME=${REPO##*/}; if [ \"$REPO_NAME\" = \"$OWNER.github.io\" ]; then GITHUB_PAGES_BASE=${GITHUB_PAGES_BASE:-/}; GITHUB_PAGES_URL=${GITHUB_PAGES_URL:-https://$OWNER.github.io}; else GITHUB_PAGES_BASE=${GITHUB_PAGES_BASE:-/$(basename \"$REPO\")/}; GITHUB_PAGES_URL=${GITHUB_PAGES_URL:-https://$OWNER.github.io$GITHUB_PAGES_BASE}; fi; echo \"Building with GITHUB_PAGES_BASE=$GITHUB_PAGES_BASE GITHUB_PAGES_URL=$GITHUB_PAGES_URL\"; GITHUB_PAGES_BASE=\"$GITHUB_PAGES_BASE\" GITHUB_PAGES_URL=\"$GITHUB_PAGES_URL\" pnpm run build'",
    "build:netlify": "astro build"
  },
  "dependencies": {
    "@astrojs/check": "latest",
    "@astrojs/netlify": "latest",
    "@astrojs/react": "latest",
    "@astrojs/rss": "latest",
    "@astrojs/sitemap": "latest",
    "@astrojs/svelte": "latest",
    "@astrojs/tailwind": "^6.0.2",
    "@swup/astro": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "astro": "latest",
    "astro-icon": "latest",
    "astro-pagefind": "latest",
    "lozad": "latest",
    "overlayscrollbars": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "latest",
    "svelte": "latest",
    "tailwindcss": "^3.4.19",
    "typescript": "latest"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0",
  "devDependencies": {
    "@iconify-json/cuida": "latest",
    "@iconify-json/dashicons": "latest",
    "@iconify-json/heroicons": "latest",
    "@iconify-json/line-md": "latest",
    "@iconify-json/mdi": "latest",
    "@iconify-json/mingcute": "latest",
    "@iconify-json/ooui": "latest",
    "@iconify/svelte": "latest",
    "@tailwindcss/typography": "latest",
    "@types/crypto-js": "latest",
    "@types/lozad": "1.16.4",
    "crypto-js": "latest",
    "mdast-util-to-string": "latest",
    "pagefind": "latest",
    "prettier": "latest",
    "prettier-plugin-astro": "latest",
    "prettier-plugin-tailwindcss": "latest",
    "reading-time": "latest",
    "rehype-autolink-headings": "latest",
    "rehype-katex": "latest",
    "rehype-slug": "latest",
    "remark-math": "latest"
  }
}
