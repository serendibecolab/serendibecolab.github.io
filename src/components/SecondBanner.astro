---
import SiteConfig from "../../site.config";
import { Image } from "astro:assets";

export interface Props {
  title?: string;
  subTitle?: string;
}

// Use secondBanners from site config (fallback to empty array)
const carouselImgsList = (SiteConfig.secondBanners ?? []) as {
  src: string;
  focalPoint?: string;
  textLines?: string[];
}[];

// Read global interval from site config; fallback to 15s
const intervalSeconds =
  SiteConfig?.bannerSettings?.intervalSeconds &&
  typeof SiteConfig.bannerSettings.intervalSeconds === "number"
    ? SiteConfig.bannerSettings.intervalSeconds
    : 15;

// Total animation time for full loop (CSS variable)
const carouselAnimationTime = `${(carouselImgsList.length || 0) * intervalSeconds}s`;
---

<div
  id="second-banner"
  class="banner relative z-10"
  data-banner-config={JSON.stringify(carouselImgsList)}
  style={`--carouselAnimationTime: ${carouselAnimationTime}`}
  data-carousel-interval={String(intervalSeconds)}
>
  <div class="transition-main banner-inner h-full w-full">
    <div class="carousel">
      <ul id="second_carousel_imgs">
        {
          carouselImgsList.map((img, index) => (
            <li
              class="item"
              style={{
                animationDelay: `${index * intervalSeconds}s`,
              }}
            >
              <Image
                src={img.src}
                alt={`Second banner image ${index + 1}`}
                width={1920}
                height={1080}
                class="absolute inset-0 h-full w-full object-cover"
                style={{ objectPosition: img.focalPoint ?? "center" }}
              />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative h-[95%] w-full">
      <div
        id="second-dynamic-banner-text"
        class="absolute bottom-8 left-8 z-20 max-w-[80%] p-4 text-left drop-shadow-md font-[var(--subtitle-font)] leading-tight"
      >
        <!-- Dynamic text inserted here -->
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const bannerElement = document.getElementById("second-banner");
    if (!bannerElement) return;

    const carouselImgs = document.getElementById("second_carousel_imgs");
    const carouselImgsCount = carouselImgs?.children.length ?? 0;

    // configured interval: prefer dataset value set server-side, fallback to 15
    const configuredInterval =
      Number(bannerElement?.dataset?.carouselInterval) || 15;

    // if no images, nothing to animate
    if (!carouselImgsCount) return;

    const carouselAnimationTime = `${carouselImgsCount * configuredInterval}s`;

    // Ensure CSS var is set so CSS takes the same total duration
    bannerElement.style.setProperty(
      "--carouselAnimationTime",
      carouselAnimationTime,
    );

    // Build keyframes dynamically in case the number of slides changes
    const carouselAnimation = `
      @keyframes carousel-animation {
        0% { opacity: 0; transform: scale(1); }
        3% { opacity: 1; }
        8% { opacity: 1; animation-timing-function: ease-out; }
        ${100 / carouselImgsCount}% { opacity: 1; }
        ${100 / carouselImgsCount + 50 / carouselImgsCount}% { opacity: 0; transform: scale(2); }
        100% { opacity: 0; transform: scale(2); }
      }
    `;

    const styleElement = document.createElement("style");
    styleElement.textContent = carouselAnimation;
    if (!bannerElement.querySelector("style")) {
      bannerElement.appendChild(styleElement);
    }

    // Apply per-item animation duration and delay
    Array.from(carouselImgs.children).forEach((item, index) => {
      (item as HTMLElement).style.animationDuration = carouselAnimationTime;
      (item as HTMLElement).style.animationDelay =
        `${index * configuredInterval}s`;
    });

    // Dynamic text scheduling (kept in sync with interval)
    const dynamicBannerTextDiv = document.getElementById(
      "second-dynamic-banner-text",
    );
    const bannerConfigData = bannerElement.dataset.bannerConfig;
    let items = [];
    if (bannerConfigData) {
      try {
        items = JSON.parse(bannerConfigData);
      } catch (e) {
        // ignore parse errors
        items = [];
      }
    }

    const imageDisplayInterval = configuredInterval * 1000;

    function updateTextContent(index) {
      if (!dynamicBannerTextDiv || !items.length) return;
      dynamicBannerTextDiv.style.opacity = "0";
      setTimeout(() => {
        dynamicBannerTextDiv.innerHTML = "";
        const current = items[index];
        if (current && current.textLines) {
          (current.textLines || []).forEach((line, lineIdx) => {
            const p = document.createElement("p");
            p.textContent = line;
            p.style.fontSize =
              lineIdx === 0
                ? "clamp(1rem, 2.5vw, 2rem)"
                : "clamp(0.9rem, 2vw, 1.6rem)";
            p.style.color = "#ffffff";
            dynamicBannerTextDiv.appendChild(p);
          });
        }
        dynamicBannerTextDiv.style.opacity = "1";
      }, 60);
    }

    function scheduleTextUpdates() {
      items.forEach((_, idx) => {
        const start = idx * imageDisplayInterval;
        setTimeout(() => updateTextContent(idx), start);
      });
    }

    scheduleTextUpdates();
    const totalLoop = items.length * imageDisplayInterval;
    setInterval(scheduleTextUpdates, totalLoop);
  });
</script>

<style define:vars={{ carouselAnimationTime }}>
  .banner {
    @apply relative h-[var(--banner-height)] opacity-100;
  }

  .carousel {
    @apply absolute left-0 top-0 -z-10 block h-[var(--banner-height)] w-full overflow-hidden bg-[var(--background-color)];
    animation-fill-mode: forwards;
  }

  .carousel::before {
    @apply absolute left-0 top-0 z-10 block h-full w-full bg-black/25 transition-all content-[''];
    @apply dark:bg-black/30;
  }

  .carousel .item {
    @apply absolute left-0 top-0 z-0 h-full w-full origin-center opacity-0;
    animation: carousel-animation var(--carouselAnimationTime) linear infinite
      0s;
    backface-visibility: hidden;
    transform-style: preserve-3d;
  }

  #second-dynamic-banner-text {
    font-size: clamp(0.9rem, 2.5vw, 1.8rem);
    position: absolute;
    bottom: 2rem;
    left: 2rem;
    text-align: left;
    transition: opacity 0.3s ease-in-out;
    z-index: 20;
    color: #ffffff;
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.6);
  }
</style>
