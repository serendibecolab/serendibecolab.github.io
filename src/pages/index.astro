---
import Base from "../layouts/BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Banner from "../components/Banner.astro";
import ImageGrid from "../components/ImageGrid.astro";
import ServiceCard from "../components/ServiceCard.astro";
import SiteConfig from "../../site.config";
import Footer from "../components/Footer.astro";

---

<Base>
  <NavBar />

  <!-- Home page shows both banners at the top -->
  <Banner variant="primary" />
  <Banner variant="secondary" />

  <div class="main-container my-10">
    <div class="flex flex-row items-start justify-center">
      <div class="transition-leaving space-y-8 w-full mx-auto">
        <main class="content onload-animation">
          <ImageGrid />

          <section class="container mx-auto px-4 py-8">
            <h2 class="text-3xl font-bold text-center mb-8 text-[var(--subtitle-color)]">Our Services</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {SiteConfig.homepageServiceCards.map((service) => (
                <ServiceCard
                  title={service.title}
                  description={service.description}
                  coverImage={service.coverImage}
                  href={service.href}
                />
              ))}
            </div>
          </section>
        </main>
        <Footer showAvatar={false} showCategoriesAndTags={false} />
      </div>
    </div>
  </div>
</Base>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const mainBanner = document.querySelector('.banner');
  const secondBanner = document.querySelector('#second-banner');
  const scrollIndicator = document.querySelector('.banner .scroll-indicator');
  
  if (!mainBanner || !secondBanner) return;

  let isScrolling = false;
  let scrollTimeout: ReturnType<typeof setTimeout> | null = null;
  let accumulatedDelta = 0;
  let lastWheelTime = 0;

  function isInMainBanner(): boolean {
    const rect = mainBanner.getBoundingClientRect();
    const threshold = window.innerHeight * 0.5;
    return rect.bottom > threshold && rect.top < window.innerHeight;
  }

  function scrollToSecondBanner(): void {
    if (isScrolling) return;
    
    isScrolling = true;
    const secondRect = secondBanner.getBoundingClientRect();
    const targetY = window.pageYOffset + secondRect.top;
    const startY = window.pageYOffset;
    const distance = targetY - startY;
    
    const duration = Math.min(700, Math.max(400, Math.abs(distance) * 0.4));
    const startTime = performance.now();

    function easeOutCubic(t: number): number {
      return 1 - Math.pow(1 - t, 3);
    }

    function animate(currentTime: number): void {
      const elapsed = currentTime - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const easedProgress = easeOutCubic(progress);
      
      window.scrollTo(0, startY + distance * easedProgress);

      if (progress < 1) {
        requestAnimationFrame(animate);
      } else {
        isScrolling = false;
      }
    }

    requestAnimationFrame(animate);
  }

  function handleWheel(event: WheelEvent): void {
    if (isScrolling) return;
    if (!isInMainBanner()) {
      accumulatedDelta = 0;
      return;
    }

    const now = Date.now();
    if (now - lastWheelTime > 100) {
      accumulatedDelta = 0;
    }
    lastWheelTime = now;
    
    if (event.deltaY > 0) {
      accumulatedDelta += event.deltaY;
      
      if (scrollTimeout) clearTimeout(scrollTimeout);
      
      scrollTimeout = setTimeout(() => {
        if (accumulatedDelta > 100 && isInMainBanner()) {
          scrollToSecondBanner();
        }
        accumulatedDelta = 0;
      }, 80);
    }
  }

  function handleKeyDown(event: KeyboardEvent): void {
    if (isScrolling || !isInMainBanner()) return;
    
    if (['ArrowDown', 'PageDown', ' '].includes(event.key)) {
      event.preventDefault();
      scrollToSecondBanner();
    }
  }

  let touchStartY = 0;
  document.addEventListener('touchstart', (e) => {
    touchStartY = e.touches[0].clientY;
  }, { passive: true });

  document.addEventListener('touchmove', (e) => {
    if (isScrolling || !isInMainBanner()) return;
    const deltaY = touchStartY - e.touches[0].clientY;
    if (deltaY > 80) {
      scrollToSecondBanner();
    }
  }, { passive: true });

  scrollIndicator?.addEventListener('click', (e) => {
    e.preventDefault();
    scrollToSecondBanner();
  });

  window.addEventListener('wheel', handleWheel, { passive: true });
  window.addEventListener('keydown', handleKeyDown);
});
</script>

<style>
  .main-container {
    @apply w-full md:min-w-[80%] md:max-w-[80%] lg:min-w-[var(--page-width-lg)] lg:max-w-[var(--page-width-lg)] xl:min-w-[var(--page-width-xl)] xl:max-w-[var(--page-width-xl)];
    @apply md:mx-auto;
  }

  .content {
    @apply w-full;
  }

  /* Optional: Add smooth scrolling to the whole page */
  html {
    scroll-behavior: smooth;
  }
</style>
